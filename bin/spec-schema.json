{
  "type": "object",
  "additionalProperties": false,
  "required": ["criteria", "conflicts", "questions"],
  "properties": {
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "check", "verifiable"],
        "properties": {
          "id": {
            "type": "string",
            "description": "AC1, AC2, ... in issue order"
          },
          "text": {
            "type": "string",
            "description": "The criterion, as written"
          },
          "check": {
            "type": "string",
            "description": "Test file and case, or command, that proves it"
          },
          "verifiable": {
            "type": "boolean",
            "description": "false if no check the implementer can run proves it"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_says", "gate", "fix"],
        "properties": {
          "issue_says": { "type": "string" },
          "gate": {
            "type": "string",
            "description": "The gate it collides with"
          },
          "fix": {
            "type": "string",
            "description": "Smallest edit to the issue"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "why", "default"],
        "properties": {
          "question": { "type": "string" },
          "why": {
            "type": "string",
            "description": "What the user would notice if guessed wrong"
          },
          "default": { "type": "string", "description": "What you'd pick" }
        }
      }
    }
  }
}
