{
  "permissions": {
    "blockWritesOutsideWorkingDirectories": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "git push *",
      "gh *",
      "pnpm test:e2e",
      "pnpm -s test:e2e",
      "pnpm verify:all",
      "pnpm -s verify:all"
    ],
    "network": {
      "allowedDomains": [],
      "allowLocalBinding": true
    },
    "credentials": {
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "CLAUDE_CODE_OAUTH_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 600,
            "command": "[ \"$FACTORY_STAGE\" = implement ] || exit 0; \"$FACTORY_DIR\"/hooks/verify-on-stop.sh"
          }
        ]
      }
    ]
  }
}
